#!/bin/bash

set -e

print_msg() {
    echo "[x] $1"
}

print_error() {
    echo "[!] $1" >&2
}

# versions
CMAKE_VERSION=4.2.1
ZIG_VERSION=0.15.2

#
# zig
#
# mirrors: https://ziglang.org/download/community-mirrors.txt
MIRROR=https://zigmirror.meox.dev

# detect aarch64 macOS
ARCH=$(uname -m)
OS=$(uname -s)
if [[ "$ARCH" == "arm64" && "$OS" == "Darwin" ]]; then
    TAR_NAME="zig-aarch64-macos-$ZIG_VERSION.tar.xz"
else
    print_error "Unsupported architecture: $ARCH on $OS"
    exit 1
fi

print_msg "Downloading Zig $TAR_NAME from $MIRROR"
TEMP_DIR=$(mktemp -d)
curl --output-dir "$TEMP_DIR" -LO "$MIRROR/$TAR_NAME?source=soup"
if [[ $? -ne 0 ]]; then
    print_error "Failed to download Zig from $MIRROR/$TAR_NAME"
    exit 1
fi

# verified offline with:
# minisign -Vm zig-aarch64-macos-0.15.2.tar.xz -P RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U
#
# ensure hash matches expected
EXPECTED_HASH=3cc2bab367e185cdfb27501c4b30b1b0653c28d9f73df8dc91488e66ece5fa6b
DOWNLOADED_HASH=$(shasum -a 256 "$TEMP_DIR/$TAR_NAME" | awk '{print $1}')
if [[ "$EXPECTED_HASH" != "$DOWNLOADED_HASH" ]]; then
    print_error "Hash mismatch! Expected $EXPECTED_HASH but got $DOWNLOADED_HASH"
    exit 1
fi

ZIG_DIR=third-party/zig
print_msg "Installing Zig to $ZIG_DIR"
rm -rf "$ZIG_DIR"
mkdir -p "$ZIG_DIR"
tar -xf "$TEMP_DIR/$TAR_NAME" --strip-components=1 -C "$ZIG_DIR"

#
# cmake
#
CMAKE_DIR=third-party/cmake
print_msg "Cloning CMake $CMAKE_VERSION to $CMAKE_DIR"
rm -rf $CMAKE_DIR
git clone --revision=v$CMAKE_VERSION https://gitlab.kitware.com/cmake/cmake.git third-party/cmake

# avoid ProcessFdQuotaExceeded errors
# https://github.com/ziglang/zig/issues/23273
ULIMIT=$(ulimit -Sn)
ulimit -Sn 4096 || print_error "Could not increase file descriptor limit, proceeding with current limit"

print_msg "Building CMake, this may take a while..."
CC="zig cc"
CXX="zig c++"
CFLAGS="-O2"
CXXFLAGS="-O2"
# CC=clang CXX=clang++ third-party/cmake/bootstrap --parallel=$(sysctl -n hw.ncpu) --prefix="$(pwd)/third-party/cmake/install"
pushd $CMAKE_DIR > /dev/null
CC="$CC" CXX="$CXX" CFLAGS="$CFLAGS" CXXFLAGS="$CXXFLAGS" ./configure
CC="$CC" CXX="$CXX" CFLAGS="$CFLAGS" CXXFLAGS="$CXXFLAGS" make
popd > /dev/null

ulimit -Sn $ULIMIT > /dev/null

# download cmocka
# git clone --revision=cmocka-2.0.2 https://git.cryptomilk.org/projects/cmocka.git third-party/cmocka

print_msg "Cleaning up"
rm -rf "$TEMP_DIR"

echo "[✔] Setup complete."